---
import { Image } from "astro:assets"
import teamData from "../../data/team.json"

// Import all team member images
import Adams from "../../media/drlynetteDadams.jpg"
import Brown from "../../media/kenbrown.png"
import Howard from "../../media/erichoward.jpg"
import Zolisha from "../../media/zolisha.jpeg"

// Create image map for dynamic imports
const imageMap = {
	"../../media/kenbrown.png": Brown,
	"../../media/zolisha.jpeg": Zolisha,
	"../../media/erichoward.jpg": Howard,
	"../../media/drlynetteDadams.jpg": Adams,
}

// Function to split description into paragraphs
function formatDescription(description) {
	return description.split("|").filter((paragraph) => paragraph.trim() !== "")
}
---

<section class="relative py-20">
	<div class="hidden lg:block lg:absolute top-0 left-36 mt-48">
		<span class="flex items-center justify-center w-16 h-16 mb-12 bg-red-300 rounded-full">👑</span>
	</div>
	<div class="hidden lg:block lg:absolute top-0 right-10 mt-96">
		<span class="flex items-center justify-center w-16 h-16 mb-12 bg-blue-300 rounded-full">🧠</span>
	</div>
	<div class="container px-5 mx-auto">
		<div class="max-w-3xl mx-auto mb-12 lg:mb-20 text-center">
			<h2 class="mt-8 mb-10 text-4xl font-semibold font-heading">Our Leaders</h2>
			<p class="text-xl text-gray-500">Meet the dedicated individuals driving our mission forward.</p>
		</div>
		<div class="flex flex-wrap -m-3">
			{
				teamData.map((member) => {
					const paragraphs = formatDescription(member.description)
					const memberImage = imageMap[member.image]

					return (
						<div class="w-full lg:w-1/2 p-3 flex">
							<div class="p-6 border rounded-xl flex-1 flex flex-col">
								<div class="flex flex-wrap -mx-5 items-start flex-1">
									<div class="w-full md:w-1/3 px-5 mb-4 lg:mb-0">
										<Image class="w-full md:w-40 h-52 object-cover rounded-xl" src={memberImage} alt={member.imageAlt} />
									</div>
									<div class="w-full md:w-2/3 px-5 flex-1">
										<h3 class="text-2xl font-semibold font-heading mb-1">{member.name}</h3>
										<p class="mb-6 text-gray-500">{member.role}</p>
										<div class="space-y-6">
											{paragraphs.map((paragraph, index) => (
												<p class="text-gray-600">{paragraph.trim()}</p>
											))}
										</div>
									</div>
								</div>
							</div>
						</div>
					)
				})
			}
		</div>
	</div>
</section>
