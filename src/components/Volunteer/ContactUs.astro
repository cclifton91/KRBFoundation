---
import Form from "./Form.astro"
import settings from "../../data/settings.json"

const { phone = settings.phone, email = settings.email, address = settings.address, name = settings.title } = Astro.props
---

<section class="py-20">
	<div class="container px-4 mx-auto">
		<div class="flex flex-wrap -mx-4">
			<div class="w-full lg:w-1/2 px-4 mb-12 lg:mb-0">
				<div class="max-w-md">
					<h2 class="mb-12 text-4xl font-semibold font-heading">Get Involved!</h2>
					<h3 class="mb-4 text-2xl font-semibold font-heading">Address</h3>
					<p class="text-gray-500">{name}</p>
					<p class="mb-10 text-gray-500">{address}</p>
					<h3 class="mb-4 text-2xl font-semibold font-heading">Contact Us</h3>
					<p class="mb-2">
						<a class="text-gray-500 hover:text-blue-600 transition-colors duration-200" href={`mailto:${email}`}>
							{email}
						</a>
					</p>
					<p class="text-gray-500">
						<a class="text-gray-500 hover:text-blue-600 transition-colors duration-200" href={`tel:+1${phone}`}>
							+ 1 ({phone.slice(0, 3)}) {phone.slice(3, 6)}-{phone.slice(6)}
						</a>
					</p>
				</div>
			</div>
			<Form />
		</div>
	</div>
</section>
