---

---

<div class="w-full lg:w-1/2 px-4">
	<form
		name="volunteer-contact"
		method="POST"
		data-netlify="true"
		netlify-honeypot="bot-field"
		x-data="{
			name: '',
			email: '',
			message: '',
			errors: {},
			isSubmitting: false,
			submitted: false,
			validateName() {
				if (!this.name.trim()) {
					this.errors.name = 'Name is required';
				} else if (this.name.trim().length < 2) {
					this.errors.name = 'Name must be at least 2 characters';
				} else {
					delete this.errors.name;
				}
			},
			validateEmail() {
				const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
				if (!this.email.trim()) {
					this.errors.email = 'Email is required';
				} else if (!emailRegex.test(this.email)) {
					this.errors.email = 'Please enter a valid email address';
				} else {
					delete this.errors.email;
				}
			},
			validateMessage() {
				if (!this.message.trim()) {
					this.errors.message = 'Message is required';
				} else if (this.message.trim().length < 10) {
					this.errors.message = 'Message must be at least 10 characters';
				} else {
					delete this.errors.message;
				}
			},
			async submitForm() {
				this.validateName();
				this.validateEmail();
				this.validateMessage();
				
				if (Object.keys(this.errors).length === 0) {
					this.isSubmitting = true;
					try {
						const response = await fetch('/', {
							method: 'POST',
							headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
							body: new URLSearchParams({
								'form-name': 'volunteer-contact',
								'name': this.name,
								'email': this.email,
								'message': this.message
							}).toString()
						});
						
						if (response.ok) {
							this.submitted = true;
							this.name = '';
							this.email = '';
							this.message = '';
						} else {
							throw new Error('Form submission failed');
						}
					} catch (error) {
						alert('There was an error submitting the form. Please try again.');
					} finally {
						this.isSubmitting = false;
					}
				}
			}
		}"
		@submit.prevent="submitForm()">
		<!-- Hidden field for Netlify bot detection -->
		<input type="hidden" name="form-name" value="volunteer-contact" />
		<div style="display: none;">
			<label>Don't fill this out if you're human: <input name="bot-field" /></label>
		</div>

		<!-- Success message -->
		<div x-show="submitted" x-transition class="mb-6 p-4 bg-green-100 border border-green-400 text-green-700 rounded">Thank you for your message! We'll get back to you soon.</div>

		<div class="relative flex flex-wrap mb-6">
			<input
				class="relative mb-2 md:mb-0 w-full py-4 pl-4 text-sm border rounded transition-colors"
				:class="errors.name ? 'border-red-500' : 'border-gray-300'"
				type="text"
				name="name"
				placeholder="Daniel"
				x-model="name"
				@blur="validateName()"
				@input="if (errors.name) validateName()"
			/>
			<span class="absolute top-0 left-0 ml-4 -mt-2 px-1 inline-block bg-white text-gray-500 text-xs">Name *</span>
			<p x-show="errors.name" x-text="errors.name" class="text-red-500 text-xs mt-1 w-full"></p>
		</div>

		<div class="relative flex flex-wrap mb-6">
			<input
				class="relative mb-2 md:mb-0 w-full py-4 pl-4 text-sm border rounded transition-colors"
				:class="errors.email ? 'border-red-500' : 'border-gray-300'"
				type="email"
				name="email"
				placeholder="e.g hello@krbfoundation.org"
				x-model="email"
				@blur="validateEmail()"
				@input="if (errors.email) validateEmail()"
			/>
			<span class="absolute top-0 left-0 ml-4 -mt-2 px-1 inline-block bg-white text-gray-500 text-xs">Your email address *</span>
			<p x-show="errors.email" x-text="errors.email" class="text-red-500 text-xs mt-1 w-full"></p>
		</div>

		<div class="relative flex flex-wrap mb-6">
			<textarea
				class="relative mb-2 md:mb-0 w-full py-4 pl-4 text-sm border rounded resize-none transition-colors"
				:class="errors.message ? 'border-red-500' : 'border-gray-300'"
				name="message"
				cols="30"
				rows="10"
				placeholder="Tell us how you'd like to volunteer..."
				x-model="message"
				@blur="validateMessage()"
				@input="if (errors.message) validateMessage()"></textarea>
			<span class="absolute top-0 left-0 ml-4 -mt-2 px-1 inline-block bg-white text-gray-500 text-xs">Your message *</span>
			<p x-show="errors.message" x-text="errors.message" class="text-red-500 text-xs mt-1 w-full"></p>
		</div>

		<button
			type="submit"
			class="w-full inline-block px-6 py-4 text-sm rounded transition duration-200 bg-green-300 hover:bg-green-400 disabled:opacity-50 disabled:cursor-not-allowed"
			:disabled="isSubmitting"
			x-text="isSubmitting ? 'Sending...' : 'Send message'"></button>
	</form>
</div>
